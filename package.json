{
  "name": "pi-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted browser control room and Pi extension for local agents",
  "license": "MIT",
  "keywords": ["pi-package", "pi", "web-ui", "pwa"],
  "repository": { "type": "git", "url": "https://github.com/EricWay1024/pi-hub.git" },
  "files": ["extensions/", "server/", "shared/", "web/", "scripts/", "deploy/", "tsconfig.json", "vite.config.ts", "package-lock.json"],
  "pi": {
    "extensions": [
      "./extensions/hub.ts"
    ]
  },
  "scripts": {
    "harden-deps": "node scripts/harden-deps.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/harden-deps.mjs && tsc --noEmit && vite build",
    "start": "tsx server/cli.ts",
    "setup": "tsx server/cli.ts setup",
    "password": "tsx server/cli.ts password",
    "reset-2fa": "tsx server/cli.ts reset-2fa",
    "test": "node scripts/harden-deps.mjs && tsx --test tests/*.test.ts",
    "check": "node scripts/harden-deps.mjs && tsc --noEmit"
  },
  "dependencies": {
    "katex": "^0.16.22",
    "otpauth": "^9.5.2",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "ws": "^8.18.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.0",
    "brace-expansion": "5.0.12",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0"
  },
  "overrides": {
    "brace-expansion": "5.0.12"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
